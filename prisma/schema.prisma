// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  USER
  ADMIN
}

enum Category {
  SOFTWARE_ENGINEER
  MECHANICAL_ENGINEER
  ELECTRICAL_ENGINEER
  ROBOTICS_ENGINEER
  ARCHITECT
  ARTIST
  DESIGNER
  DATA_SCIENTIST
  WRITER
  OTHER
}

enum MediaKind {
  UPLOAD
  EXTERNAL
}

enum LayoutMode {
  GRID
  CANVAS
}

enum CanvasElementType {
  ABOUT
  LINKS
  PROJECT
  TEXT
  IMAGE
  LINK
}

enum CanvasElementState {
  DRAFT
  PUBLISHED
}

model User {
  id                    String            @id @default(cuid())
  username              String            @unique
  passwordHash          String?
  email                 String?           @unique
  role                  Role              @default(USER)
  displayName           String
  bio                   String?
  school                String?
  avatarUrl             String?
  links                 Json?
  theme                 String            @default("default")
  layoutSections        Json?
  layoutMode            LayoutMode        @default(GRID)
  canvasDraftSavedAt    DateTime?
  canvasPublishedAt     DateTime?
  canvasHintDismissedAt DateTime?
  customCss             String?
  banned                Boolean           @default(false)
  createdAt             DateTime          @default(now())
  projects              Project[]
  reportsMade           Report[]          @relation("ReportsMade")
  reportsAgainst        Report[]          @relation("ReportsAgainstUser")
  accounts              Account[]
  oauthLinkIntents      OAuthLinkIntent[]
  canvasElements        CanvasElement[]
}

model Account {
  id                String @id @default(cuid())
  userId            String
  user              User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider          String
  providerAccountId String

  @@unique([provider, providerAccountId])
  @@unique([userId, provider])
}

model PendingOAuthSignup {
  id                String   @id @default(cuid())
  tokenHash         String   @unique
  provider          String
  providerAccountId String
  email             String?
  emailVerified     Boolean
  name              String?
  expiresAt         DateTime
  completedUserId   String?
  createdAt         DateTime @default(now())

  @@index([expiresAt])
}

model OAuthLinkIntent {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider  String
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([expiresAt])
}

model LoginAttempt {
  username      String    @id
  failedCount   Int
  firstFailedAt DateTime
  lockedUntil   DateTime?
}

model Project {
  id             String          @id @default(cuid())
  userId         String
  user           User            @relation(fields: [userId], references: [id])
  title          String
  description    String
  category       Category
  hashtags       String[]
  links          String[]
  layout         String          @default("default")
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  media          ProjectMedia[]
  reports        Report[]
  canvasElements CanvasElement[]

  @@index([userId])
  @@index([category])
}

model CanvasElement {
  id           String             @id @default(cuid())
  userId       String
  user         User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  state        CanvasElementState
  type         CanvasElementType
  projectId    String?
  project      Project?           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  x            Int
  y            Int
  width        Int
  height       Int
  zIndex       Int
  textContent  String?
  imageUrl     String?
  imageCaption String?
  linkLabel    String?
  linkUrl      String?

  @@index([userId, state])
}

model ProjectMedia {
  id        String    @id @default(cuid())
  projectId String
  project   Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  kind      MediaKind
  url       String
  mimeType  String?
  order     Int       @default(0)

  @@index([projectId])
}

model Report {
  id             String   @id @default(cuid())
  reporterId     String
  reporter       User     @relation("ReportsMade", fields: [reporterId], references: [id])
  projectId      String?
  project        Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)
  reportedUserId String?
  reportedUser   User?    @relation("ReportsAgainstUser", fields: [reportedUserId], references: [id])
  reason         String?
  createdAt      DateTime @default(now())

  @@index([projectId])
  @@index([reportedUserId])
  @@index([createdAt])
}
