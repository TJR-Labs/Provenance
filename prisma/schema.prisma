// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  ADMIN
  COMPANY
  ENGINEER
}

enum BriefDomain {
  SOFTWARE
  ML_AI
  HARDWARE_ROBOTICS
}

enum BriefStatus {
  OPEN
  CLOSED
}

model User {
  id           String   @id @default(cuid())
  username     String   @unique
  passwordHash String
  role         Role
  displayName  String
  companyName  String?
  createdAt    DateTime @default(now())
  briefs       Brief[]
}

model Brief {
  id           String      @id @default(cuid())
  companyId    String
  company      User        @relation(fields: [companyId], references: [id])
  title        String
  summary      String
  description  String
  domain       BriefDomain
  deliverables String
  status       BriefStatus @default(OPEN)
  createdAt    DateTime    @default(now())
  closedAt     DateTime?

  @@index([companyId])
  @@index([status, domain, createdAt])
}
