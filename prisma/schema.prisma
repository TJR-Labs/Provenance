// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  USER
  ADMIN
}

enum Category {
  SOFTWARE_ENGINEER
  MECHANICAL_ENGINEER
  ELECTRICAL_ENGINEER
  ROBOTICS_ENGINEER
  ARCHITECT
  ARTIST
  DESIGNER
  DATA_SCIENTIST
  WRITER
  OTHER
}

enum MediaKind {
  UPLOAD
  EXTERNAL
}

model User {
  id             String    @id @default(cuid())
  username       String    @unique
  passwordHash   String
  role           Role      @default(USER)
  displayName    String
  bio            String?
  school         String?
  avatarUrl      String?
  links          Json?
  theme          String    @default("default")
  layoutSections Json?
  customCss      String?
  banned         Boolean   @default(false)
  createdAt      DateTime  @default(now())
  projects       Project[]
  reportsMade    Report[]  @relation("ReportsMade")
  reportsAgainst Report[]  @relation("ReportsAgainstUser")
}

model LoginAttempt {
  username      String    @id
  failedCount   Int
  firstFailedAt DateTime
  lockedUntil   DateTime?
}

model Project {
  id          String         @id @default(cuid())
  userId      String
  user        User           @relation(fields: [userId], references: [id])
  title       String
  description String
  category    Category
  hashtags    String[]
  links       String[]
  layout      String         @default("default")
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  media       ProjectMedia[]
  reports     Report[]

  @@index([userId])
  @@index([category])
}

model ProjectMedia {
  id        String    @id @default(cuid())
  projectId String
  project   Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  kind      MediaKind
  url       String
  mimeType  String?
  order     Int       @default(0)

  @@index([projectId])
}

model Report {
  id             String   @id @default(cuid())
  reporterId     String
  reporter       User     @relation("ReportsMade", fields: [reporterId], references: [id])
  projectId      String?
  project        Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)
  reportedUserId String?
  reportedUser   User?    @relation("ReportsAgainstUser", fields: [reportedUserId], references: [id])
  reason         String?
  createdAt      DateTime @default(now())

  @@index([projectId])
  @@index([reportedUserId])
  @@index([createdAt])
}
