// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  USER
  ADMIN
}

enum Category {
  SOFTWARE_ENGINEER
  MECHANICAL_ENGINEER
  ELECTRICAL_ENGINEER
  ROBOTICS_ENGINEER
  ARCHITECT
  ARTIST
  DESIGNER
  DATA_SCIENTIST
  WRITER
  OTHER
}

enum MediaKind {
  UPLOAD
  EXTERNAL
}

enum LayoutMode {
  GRID
  CANVAS
}

enum CanvasElementType {
  ABOUT
  LINKS
  PROJECT
  TEXT
  IMAGE
  LINK
  AVATAR
  NAME
  USERNAME
  CATEGORIES
}

enum CanvasElementState {
  DRAFT
  PUBLISHED
}

model User {
  id                    String            @id @default(cuid())
  username              String            @unique
  passwordHash          String?
  email                 String?           @unique
  role                  Role              @default(USER)
  displayName           String
  bio                   String?
  school                String?
  avatarUrl             String?
  links                 Json?
  theme                 String            @default("default")
  layoutSections        Json?
  layoutMode            LayoutMode        @default(GRID)
  canvasDraftSavedAt    DateTime?
  canvasPublishedAt     DateTime?
  canvasHintDismissedAt DateTime?
  onboardingDismissedAt DateTime?
  customCss             String?
  banned                Boolean           @default(false)
  private               Boolean           @default(false)
  createdAt             DateTime          @default(now())
  projects              Project[]
  reportsMade           Report[]          @relation("ReportsMade")
  reportsAgainst        Report[]          @relation("ReportsAgainstUser")
  accounts              Account[]
  oauthLinkIntents      OAuthLinkIntent[]
  canvasElements        CanvasElement[]
}

model Account {
  id                String @id @default(cuid())
  userId            String
  user              User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider          String
  providerAccountId String

  @@unique([provider, providerAccountId])
  @@unique([userId, provider])
}

model PendingOAuthSignup {
  id                String   @id @default(cuid())
  tokenHash         String   @unique
  provider          String
  providerAccountId String
  email             String?
  emailVerified     Boolean
  name              String?
  expiresAt         DateTime
  completedUserId   String?
  createdAt         DateTime @default(now())

  @@index([expiresAt])
}

model OAuthLinkIntent {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider  String
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([expiresAt])
}

model LoginAttempt {
  username      String    @id
  failedCount   Int
  firstFailedAt DateTime
  lockedUntil   DateTime?
}

// Reusable rate-limit/lockout ledger, modeled on LoginAttempt: a rolling
// window count keyed by an arbitrary (scope, key) pair, with an optional
// lockout timestamp once a threshold is reached. `scope` namespaces the
// limiter (e.g. "signup", "report", "change-password") and `key` identifies
// the caller within that scope (an IP address or a user id).
model RateLimitAttempt {
  scope       String
  key         String
  count       Int
  windowStart DateTime
  lockedUntil DateTime?

  @@id([scope, key])
}

model Project {
  id             String          @id @default(cuid())
  userId         String
  user           User            @relation(fields: [userId], references: [id])
  title          String
  description    String
  category       Category
  hashtags       String[]
  links          String[]
  layout         String          @default("default")
  private        Boolean         @default(false)
  excludeFromFeed Boolean        @default(false)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  media          ProjectMedia[]
  reports        Report[]
  canvasElements CanvasElement[]

  @@index([userId])
  @@index([category])
}

model CanvasElement {
  id           String             @id @default(cuid())
  userId       String
  user         User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  state        CanvasElementState
  type         CanvasElementType
  projectId    String?
  project      Project?           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  x            Int
  y            Int
  width        Int
  height       Int
  zIndex       Int
  textContent  String?
  imageUrl     String?
  imageCaption String?
  linkLabel    String?
  linkUrl      String?
  textColor       String?
  backgroundColor String?
  fontFamily      String?
  avatarShape     String?
  avatarZoom      Int?
  avatarOffsetX   Int?
  avatarOffsetY   Int?
  // Canvas-only overrides for a placed PROJECT element. Each is scoped to this
  // one CanvasElement row and never touches the underlying Project record.
  // Null = unset (fall back to the real project value). For hashtags, a Json
  // column distinguishes unset (SQL NULL) from an explicit empty-list override
  // (`[]`), which a nullable String[] cannot express.
  projectTitleOverride       String?
  projectDescriptionOverride String?
  projectHashtagsOverride    Json?
  cardLayout                 String?

  @@index([userId, state])
}

model ProjectMedia {
  id        String    @id @default(cuid())
  projectId String
  project   Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  kind      MediaKind
  url       String
  mimeType  String?
  order     Int       @default(0)

  @@index([projectId])
}

model Report {
  id             String   @id @default(cuid())
  reporterId     String
  reporter       User     @relation("ReportsMade", fields: [reporterId], references: [id])
  projectId      String?
  project        Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)
  reportedUserId String?
  reportedUser   User?    @relation("ReportsAgainstUser", fields: [reportedUserId], references: [id])
  reason         String?
  createdAt      DateTime @default(now())

  @@index([projectId])
  @@index([reportedUserId])
  @@index([createdAt])
}
