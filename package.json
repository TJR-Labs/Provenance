{
  "name": "provenance",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "backup:database": "tsx scripts/backup-database.ts",
    "build": "next build",
    "check": "eslint src && tsc --noEmit",
    "cleanup:rate-limits": "tsx scripts/cleanup-rate-limits.ts",
    "cleanup:uploads": "tsx scripts/cleanup-upload-staging.ts",
    "storage:reconcile": "tsx scripts/reconcile-storage.ts",
    "storage:report": "tsx scripts/storage-report.ts",
    "db:generate": "prisma migrate dev",
    "db:migrate": "prisma migrate deploy",
    "db:push": "prisma db push",
    "db:studio": "prisma studio",
    "dev": "next dev --turbo",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,mdx}\" --cache",
    "format:write": "prettier --write \"**/*.{ts,tsx,js,jsx,mdx}\" --cache",
    "grid:migrate": "tsx prisma/migrate-grid-layouts.ts",
    "postinstall": "prisma generate",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "preview": "next build && next start",
    "start": "next start",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "vercel-build": "node scripts/vercel-build.js"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.6.0",
    "@react-email/render": "^1.4.0",
    "@supabase/supabase-js": "^2.110.6",
    "@t3-oss/env-nextjs": "^0.12.0",
    "@tanstack/react-query": "^5.69.0",
    "@trpc/client": "^11.0.0",
    "@trpc/react-query": "^11.0.0",
    "@trpc/server": "^11.0.0",
    "bcryptjs": "^3.0.3",
    "next": "^15.5.21",
    "next-auth": "5.0.0-beta.32",
    "postcss": "^8.5.19",
    "postcss-selector-parser": "^7.1.4",
    "posthog-js": "^1.405.2",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "resend": "^6.1.0",
    "sanitize-html": "^2.17.6",
    "server-only": "^0.0.1",
    "superjson": "^2.2.1",
    "zod": "^3.24.2"
  },
  "overrides": {
    "next": {
      "postcss": "^8.5.22",
      "sharp": "^0.35.3"
    }
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.1",
    "@tailwindcss/postcss": "^4.0.15",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^20.14.10",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/sanitize-html": "^2.16.1",
    "@vitejs/plugin-react": "^6.0.3",
    "eslint": "^9.23.0",
    "eslint-config-next": "^15.2.3",
    "jsdom": "^29.1.1",
    "prettier": "^3.5.3",
    "prettier-plugin-tailwindcss": "^0.6.11",
    "prisma": "^6.6.0",
    "tailwindcss": "^4.0.15",
    "tsx": "^4.23.1",
    "typescript": "^5.8.2",
    "typescript-eslint": "^8.27.0",
    "vitest": "^4.1.10"
  },
  "ct3aMetadata": {
    "initVersion": "7.40.0"
  },
  "packageManager": "npm@11.16.0",
  "allowScripts": {
    "prisma@6.19.3": true,
    "sharp@0.34.5": true,
    "unrs-resolver@1.12.2": true,
    "@prisma/client@6.19.3": true,
    "@prisma/engines@6.19.3": true
  }
}
