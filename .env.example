# Copy this file to .env and replace every placeholder. Never commit .env.

# Generate with `npx auth secret`.
AUTH_SECRET="replace-with-generated-auth-secret"

# Resend transactional email. Required in Production. Leave both unset in
# local/test environments to skip delivery while still creating hashed tokens.
RESEND_API_KEY="replace-with-resend-api-key"
EMAIL_FROM="Provenance <accounts@your-verified-domain.example>"

# Google Cloud Console OAuth client credentials.
# Register: http://localhost:3000/api/auth/callback/google (and the same path on your production domain).
GOOGLE_CLIENT_ID="replace-with-google-client-id"
GOOGLE_CLIENT_SECRET="replace-with-google-client-secret"

# GitHub OAuth App credentials.
# Register: http://localhost:3000/api/auth/callback/github (and the same path on your production domain).
GITHUB_CLIENT_ID="replace-with-github-client-id"
GITHUB_CLIENT_SECRET="replace-with-github-client-secret"

# Optional. If unset, the first database seed prints a random admin password once.
ADMIN_PASSWORD=""

# Supabase Dashboard: Settings → Database → Connection string → Transaction pooler.
# Use the port 6543 URL and replace the project reference, region, and password.
DATABASE_URL="postgresql://postgres.project-ref:replace-with-database-password@aws-0-us-west-1.pooler.supabase.com:6543/postgres?pgbouncer=true"

# Supabase Dashboard: Settings → Database → Connection string → Direct connection.
# Use the port 5432 URL and replace the project reference and password.
DIRECT_URL="postgresql://postgres:replace-with-database-password@db.project-ref.supabase.co:5432/postgres"

# Supabase Dashboard: Settings → API. Use the project URL and service-role key.
SUPABASE_URL="https://project-ref.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="replace-with-service-role-key"

# Supabase Storage bucket used for project images, videos, and profile pictures.
SUPABASE_STORAGE_BUCKET="project-media"

# PRIVATE Supabase Storage bucket used while uploads await server validation.
# Create this bucket manually in the Supabase dashboard and do not make it public.
SUPABASE_STORAGE_STAGING_BUCKET="upload-staging"
